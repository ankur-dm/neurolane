{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/brain/neurolane.mjs\" hook prompt --brain \"$CLAUDE_PROJECT_DIR/brain\"" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/brain/neurolane.mjs\" hook pre-edit --brain \"$CLAUDE_PROJECT_DIR/brain\"" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/brain/neurolane.mjs\" hook post-edit --brain \"$CLAUDE_PROJECT_DIR/brain\"" } ] }
    ]
  }
}
